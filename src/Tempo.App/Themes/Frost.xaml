<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Read by ThemeService: -->
    <sys:Boolean x:Key="Theme.IsDark">True</sys:Boolean>
    <sys:String x:Key="Theme.Backdrop">Acrylic</sys:String>
    <sys:Double x:Key="Theme.CornerRadius">18</sys:Double>
    <Color x:Key="Bar.BackgroundColor">#2EFFFFFF</Color>

    <SolidColorBrush x:Key="Bar.Background" Color="{StaticResource Bar.BackgroundColor}" />
    <SolidColorBrush x:Key="Bar.Foreground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Bar.SubtleForeground" Color="#C0FFFFFF" />
    <SolidColorBrush x:Key="Bar.Border" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="Widget.HoverBackground" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="Widget.PressedBackground" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Accent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Accent.Foreground" Color="#FF111111" />
    <SolidColorBrush x:Key="Flyout.Background" Color="#E62A2D36" />
    <SolidColorBrush x:Key="Flyout.Border" Color="#40FFFFFF" />
    <FontFamily x:Key="Bar.FontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <sys:Double x:Key="Bar.FontSize">13</sys:Double>
</ResourceDictionary>
