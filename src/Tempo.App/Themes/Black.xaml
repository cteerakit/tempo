<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Read by ThemeService: -->
    <sys:Boolean x:Key="Theme.IsDark">True</sys:Boolean>
    <sys:String x:Key="Theme.Backdrop">None</sys:String>
    <sys:Double x:Key="Theme.CornerRadius">12</sys:Double>
    <Color x:Key="Bar.BackgroundColor">#FF000000</Color>

    <SolidColorBrush x:Key="Bar.Background" Color="{StaticResource Bar.BackgroundColor}" />
    <SolidColorBrush x:Key="Bar.Foreground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Bar.SubtleForeground" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="Bar.Border" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="Widget.HoverBackground" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Widget.PressedBackground" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="Accent" Color="#FF22D3EE" />
    <SolidColorBrush x:Key="Accent.Foreground" Color="#FF000000" />
    <SolidColorBrush x:Key="Flyout.Background" Color="#FF0E0E10" />
    <SolidColorBrush x:Key="Flyout.Border" Color="#26FFFFFF" />
    <FontFamily x:Key="Bar.FontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <sys:Double x:Key="Bar.FontSize">13</sys:Double>
</ResourceDictionary>
